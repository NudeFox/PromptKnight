{
  "name": "promptknight",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @promptknight/extension dev",
    "build": "pnpm --filter @promptknight/extension build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript-eslint": "^8.48.0",
    "typescript": "^5.9.3",
    "prettier": "^3.7.4",
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@types/node": "^24.10.0"
  }
}
